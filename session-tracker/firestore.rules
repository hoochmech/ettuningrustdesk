rules_version = '2';
// Only people listed in the `staff` collection (document ID = their Google account
// email) can use the dashboard. Sessions, devices and files are written by the
// Cloud Functions, which bypass these rules; staff may only change the job details.
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/staff/$(request.auth.token.email));
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /staff/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
    }
    match /customers/{id} {
      allow read, create, update: if isStaff();
    }
    match /work_categories/{id} {
      allow read, write: if isStaff();
    }
    match /lists/{id} {
      allow read, write: if isStaff();
    }
    match /engine_makes/{id} {
      allow read, write: if isStaff();
    }
    match /devices/{id} {
      allow read: if isStaff();
      allow update: if isStaff() && onlyChanges(['customer_id', 'label']);
    }
    match /sessions/{id} {
      allow read: if isStaff();
      allow update: if isStaff()
        && onlyChanges(['customer_id', 'category_id', 'category_name', 'billable', 'warranty_issue',
                        'original_job_id', 'original_job_pre_tracking', 'original_job_note',
                        'vehicle_make', 'engine_make', 'engine_model', 'ecm_type', 'files', 'file_ids', 'notes',
                        'status', 'completed_at', 'completed_by', 'merged_into'])
        && request.resource.data.status in ['needs_details', 'complete', 'dismissed', 'merged'];
    }
    match /files/{id} {
      allow read: if isStaff();
    }
    match /conn_events/{id} {
      allow read: if isStaff();
    }
  }
}
